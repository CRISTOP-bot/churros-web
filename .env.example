NODE_ENV=production
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=https://www.churroslinux.org

# Internal-only Action API endpoint. Do not use the public origin here.
WIKI_API_URL=http://127.0.0.1:8081/api.php
WIKI_TIMEOUT_MS=8000
WIKI_MAIN_PAGE=Página principal
WIKI_FEATURED_CATEGORY=Destacados

# Public OAuth endpoint provided by Extension:OAuth through nginx.
WIKI_OAUTH_BASE_URL=https://www.churroslinux.org/wiki-engine/rest.php/oauth2
WIKI_OAUTH_CLIENT_ID=replace-with-mediawiki-oauth-client-id
WIKI_OAUTH_CLIENT_SECRET=replace-with-mediawiki-oauth-client-secret
WIKI_OAUTH_REDIRECT_URI=https://www.churroslinux.org/api/wiki/auth/callback
WIKI_OAUTH_SCOPE=basic editpage createeditmovepage

# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
SESSION_TTL_SECONDS=28800
RATE_LIMIT_READ=120
RATE_LIMIT_WRITE=20
